# ============================================================================
# Param Imaging 工程命令（六西格玛 DMAIC 部署门禁）
# 用法: make <target>
#   check    -> 全量门禁（锁检查 + 数据校验 + 构建）
#   verify   -> 数据哈希校验
#   build    -> 构建 Docker 镜像
#   test     -> 运行实验复现（需 data/validation_package_v2.0）
#   clean    -> 清理构建产物
# ============================================================================

SHELL       := /bin/bash
.PHONY: all check verify build test clean

IMAGE      ?= ghcr.io/$(shell echo $${GITHUB_REPOSITORY:-param-imaging/param-imaging} | tr '[:upper:]' '[:lower:]'):latest
SEED       ?= 0x612

all: check

# ---------------------------------------------------------------------------
# 门禁：数据完整性 + 依赖锁定 + 构建冒烟
# ---------------------------------------------------------------------------
check: verify build
	@echo "==> [OK] 全部门禁通过"

# ---------------------------------------------------------------------------
# 验证：产物哈希链校验（HAF003 记录管理要素）
# ---------------------------------------------------------------------------
verify:
	@echo "==> 校验数据哈希链 (seed=$(SEED))"
	@if [ -f checksums.sha256 ] && [ -s checksums.sha256 ] && grep -qE '^[0-9a-f]{64}  ' checksums.sha256; then \
		sha256sum -c checksums.sha256 || { echo "[FAIL] 数据校验失败"; exit 1; }; \
	else \
		echo "[SKIP] checksums.sha256 无有效哈希行，跳过（数据包上传后执行 scripts/checksum.sh generate）"; \
	fi

# ---------------------------------------------------------------------------
# 构建：Docker 镜像（多阶段，含依赖层缓存）
# ---------------------------------------------------------------------------
build:
	@echo "==> 构建镜像 $(IMAGE)"
	docker build --build-arg SEED=$(SEED) -t $(IMAGE) .

# ---------------------------------------------------------------------------
# 测试：实验复现（Docker 环境锁内运行）
# ---------------------------------------------------------------------------
test:
	@echo "==> 运行实验复现 (seed=$(SEED))"
	docker run --rm -e SEED=$(SEED) $(IMAGE)

# ---------------------------------------------------------------------------
# 清理
# ---------------------------------------------------------------------------
clean:
	@rm -rf build/ dist/ __pycache__
	@echo "==> 已清理构建产物"
